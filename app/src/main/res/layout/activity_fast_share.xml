<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:elevation="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_mode_share"
            style="?attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/fs_mode_share" />

        <Button
            android:id="@+id/btn_mode_pull"
            style="?attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/fs_mode_pull" />
    </LinearLayout>

    <!-- 分享面板 -->
    <LinearLayout
        android:id="@+id/share_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/share_pick_folder"
            style="?attr/buttonBarButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fs_pick_folder_title" />

        <Button
            android:id="@+id/share_pick_file"
            style="?attr/buttonBarButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fs_pick_file" />

        <TextView
            android:id="@+id/share_target"
            style="@style/textSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/fs_no_files_selected" />

        <Button
            android:id="@+id/share_set_key"
            style="?attr/buttonBarButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fs_set_key_title" />

        <Button
            android:id="@+id/share_start"
            style="?attr/buttonBarButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fs_share_start" />

        <Button
            android:id="@+id/share_stop"
            style="?attr/buttonBarButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fs_stop"
            android:visibility="gone" />

        <TextView
            android:id="@+id/share_status"
            style="@style/textSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- 接收面板 -->
    <LinearLayout
        android:id="@+id/pull_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <EditText
            android:id="@+id/pull_ip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/fs_peer_ip"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/pull_port"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/fs_port"
            android:inputType="number"
            android:text="8899" />

        <EditText
            android:id="@+id/pull_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/fs_pull_key_title" />

        <Button
            android:id="@+id/pull_pick_dir"
            style="?attr/buttonBarButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fs_pull_pick_dir" />

        <TextView
            android:id="@+id/pull_save_to"
            style="@style/textSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/fs_no_files_selected" />

        <Button
            android:id="@+id/pull_start"
            style="?attr/buttonBarButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fs_pull_start" />

        <Button
            android:id="@+id/pull_stop"
            style="?attr/buttonBarButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fs_stop"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 公共进度 -->
    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:max="100"
        android:visibility="gone" />

    <TextView
        android:id="@+id/phase_text"
        style="@style/textSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/remaining_text"
        style="@style/textSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
